APP_ROOT=/home/pi/furnace-brain
FRONT_DIR=/home/pi/furnace-brain/frontend

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080

PYTHONPATH=/home/pi/furnace-brain
FURNACE_BRAIN_DATA_ROOT=/mnt/usb/furnace-brain
FURNACE_BRAIN_HW_RPI=1

# remote read-only view ("Podgląd zdalny" module, enable it in the settings)
# (setup: README, "Remote view of the furnace")
#FURNACE_BRAIN_VIEWER_FIREBASE_URL=https://<project>-default-rtdb.europe-west1.firebasedatabase.app
#FURNACE_BRAIN_VIEWER_FIREBASE_SECRET=<Firebase database secret>
#FURNACE_BRAIN_VIEWER_KEY=<random, at least 20 characters: openssl rand -hex 16>

# phone alerts ("Powiadomienia" module, enable it in the settings):
# install the ntfy app, subscribe to the same random topic name
#FURNACE_BRAIN_NTFY_TOPIC=<random, e.g. piec-$(openssl rand -hex 6)>
#FURNACE_BRAIN_NTFY_SERVER=https://ntfy.sh
